{% assign move_percent_raw = rings.move_percent | default: 0 | plus: 0 %}
{% assign exercise_percent_raw = rings.exercise_percent | default: 0 | plus: 0 %}
{% assign stand_percent_raw = rings.stand_percent | default: 0 | plus: 0 %}

{% assign move_progress = move_percent_raw %}
{% if move_progress < 0 %}{% assign move_progress = 0 %}{% endif %}
{% if move_progress > 100 %}{% assign move_progress = 100 %}{% endif %}

{% assign exercise_progress = exercise_percent_raw %}
{% if exercise_progress < 0 %}{% assign exercise_progress = 0 %}{% endif %}
{% if exercise_progress > 100 %}{% assign exercise_progress = 100 %}{% endif %}

{% assign stand_progress = stand_percent_raw %}
{% if stand_progress < 0 %}{% assign stand_progress = 0 %}{% endif %}
{% if stand_progress > 100 %}{% assign stand_progress = 100 %}{% endif %}

{% assign move_remaining = 100 | minus: move_progress %}
{% assign exercise_remaining = 100 | minus: exercise_progress %}
{% assign stand_remaining = 100 | minus: stand_progress %}

{% assign move_offset = 509 | times: move_remaining | divided_by: 100 %}
{% assign exercise_offset = 358 | times: exercise_remaining | divided_by: 100 %}
{% assign stand_offset = 207 | times: stand_remaining | divided_by: 100 %}

<div class="layout layout--col">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td valign="top">
        <strong>Activity Rings</strong>
        <div>{{ date_label | default: "Today" }}</div>
      </td>
      <td align="right" valign="top">
        <strong>{{ activity.steps | default: 0 }}</strong> steps
      </td>
    </tr>
  </table>

  <div class="outline rounded">
    <table width="100%" cellpadding="10" cellspacing="0">
      <tr>
        <td width="130" align="center" valign="middle">
          <svg width="116" height="116" viewBox="0 0 240 240" role="img" aria-label="Apple Health activity rings">
            <circle cx="120" cy="120" r="81" fill="none" stroke="#f1f1eb" stroke-width="24"></circle>
            <circle cx="120" cy="120" r="57" fill="none" stroke="#f1f1eb" stroke-width="24"></circle>
            <circle cx="120" cy="120" r="33" fill="none" stroke="#f1f1eb" stroke-width="22"></circle>
            <circle cx="120" cy="120" r="81" fill="none" stroke="#d9d9d2" stroke-width="16"></circle>
            <circle cx="120" cy="120" r="57" fill="none" stroke="#d9d9d2" stroke-width="16"></circle>
            <circle cx="120" cy="120" r="33" fill="none" stroke="#d9d9d2" stroke-width="14"></circle>
            <circle cx="120" cy="120" r="81" fill="none" stroke="#111111" stroke-width="16" stroke-linecap="round" stroke-dasharray="509" stroke-dashoffset="{{ move_offset }}" transform="rotate(-90 120 120)"></circle>
            <circle cx="120" cy="120" r="57" fill="none" stroke="#535353" stroke-width="16" stroke-linecap="round" stroke-dasharray="358" stroke-dashoffset="{{ exercise_offset }}" transform="rotate(-90 120 120)"></circle>
            <circle cx="120" cy="120" r="33" fill="none" stroke="#8f8f8f" stroke-width="14" stroke-linecap="round" stroke-dasharray="207" stroke-dashoffset="{{ stand_offset }}" transform="rotate(-90 120 120)"></circle>
          </svg>
        </td>
        <td valign="middle">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td>Move</td>
              <td align="right"><strong>{{ rings.move | default: 0 }}</strong> CAL</td>
              <td align="right"><strong>{{ move_percent_raw }}%</strong></td>
            </tr>
            <tr>
              <td colspan="3"><hr></td>
            </tr>
            <tr>
              <td>Exercise</td>
              <td align="right"><strong>{{ rings.exercise | default: 0 }}</strong> MIN</td>
              <td align="right"><strong>{{ exercise_percent_raw }}%</strong></td>
            </tr>
            <tr>
              <td colspan="3"><hr></td>
            </tr>
            <tr>
              <td>Stand</td>
              <td align="right"><strong>{{ rings.stand | default: 0 }}</strong> HRS</td>
              <td align="right"><strong>{{ stand_percent_raw }}%</strong></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>

  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td>{{ activity.distance_mi | default: 0 }} MI</td>
      <td align="right">
        {% if sync_time_label %}
          Updated {{ sync_time_label }}
        {% endif %}
      </td>
    </tr>
  </table>
</div>
