{% assign move_percent_raw = rings.move_percent | default: 0 | plus: 0 %}
{% assign exercise_percent_raw = rings.exercise_percent | default: 0 | plus: 0 %}
{% assign stand_percent_raw = rings.stand_percent | default: 0 | plus: 0 %}

{% assign move_progress = move_percent_raw %}
{% if move_progress < 0 %}{% assign move_progress = 0 %}{% endif %}
{% if move_progress > 100 %}{% assign move_progress = 100 %}{% endif %}

{% assign exercise_progress = exercise_percent_raw %}
{% if exercise_progress < 0 %}{% assign exercise_progress = 0 %}{% endif %}
{% if exercise_progress > 100 %}{% assign exercise_progress = 100 %}{% endif %}

{% assign stand_progress = stand_percent_raw %}
{% if stand_progress < 0 %}{% assign stand_progress = 0 %}{% endif %}
{% if stand_progress > 100 %}{% assign stand_progress = 100 %}{% endif %}

{% assign move_remaining = 100 | minus: move_progress %}
{% assign exercise_remaining = 100 | minus: exercise_progress %}
{% assign stand_remaining = 100 | minus: stand_progress %}

{% assign move_offset = 465 | times: move_remaining | divided_by: 100 %}
{% assign exercise_offset = 327 | times: exercise_remaining | divided_by: 100 %}
{% assign stand_offset = 188 | times: stand_remaining | divided_by: 100 %}
{% assign captured_time = captured_at | date: "%-I:%M %p" %}

<style>
  .health-screen {
    height: 100%;
    padding: 16px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
    background: #f4f4f1;
    color: #111;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  }

  .health-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .health-header__title {
    display: block;
    font-size: 27px;
    line-height: 1;
    font-weight: 700;
    margin-bottom: 3px;
  }

  .health-header__meta {
    display: block;
    font-size: 14px;
    line-height: 1.15;
    color: #666;
  }

  .health-shell {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 10px;
    min-height: 0;
  }

  .health-card {
    background: #fff;
    border: 1px solid #d7d7d0;
    border-radius: 18px;
  }

  .health-hero {
    min-height: 0;
    padding: 14px 16px;
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 12px;
    align-items: center;
  }

  .health-rings {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
  }

  .health-rings svg {
    width: 214px;
    height: 214px;
  }

  .ring-separator {
    fill: none;
    stroke: #f4f4f1;
  }

  .ring-track {
    fill: none;
    stroke: #ddddd6;
  }

  .ring-progress {
    fill: none;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 120px 120px;
  }

  .ring-progress--move {
    stroke: #111;
  }

  .ring-progress--exercise {
    stroke: #4f4f4f;
  }

  .ring-progress--stand {
    stroke: #8d8d8d;
  }

  .ring-center {
    font-size: 13px;
    fill: #666;
    text-anchor: middle;
  }

  .ring-center__value {
    font-size: 30px;
    font-weight: 700;
    fill: #111;
  }

  .health-stats {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    min-height: 0;
    padding: 4px 6px 4px 2px;
  }

  .health-stat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid #ecece5;
  }

  .health-stat:last-child {
    border-bottom: none;
  }

  .health-stat__label {
    display: block;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #707070;
    margin-bottom: 4px;
  }

  .health-stat__value {
    display: block;
    font-size: 28px;
    line-height: 1;
    font-weight: 700;
    color: #111;
  }

  .health-stat__goal {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: #666;
  }

  .health-stat__badge {
    align-self: start;
    font-size: 14px;
    line-height: 1;
    font-weight: 700;
    color: #111;
    background: #f0f0eb;
    border: 1px solid #d9d9d2;
    border-radius: 999px;
    padding: 6px 10px 5px;
  }

  .health-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .health-metric {
    padding: 12px 14px 11px;
    min-height: 84px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .health-metric__label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  .health-metric__value {
    font-size: 31px;
    line-height: 1;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
  }

  .health-metric__detail {
    font-size: 13px;
    color: #666;
  }

  .health-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #666;
    padding: 0 2px;
  }
</style>

<div class="screen">
  <div class="view view--full">
    <div class="health-screen">
      <div class="health-header">
        <div>
          <span class="health-header__title">Activity Rings</span>
          <span class="health-header__meta">{{ date_label | default: "Today" }}</span>
        </div>
        <div style="text-align:right;">
          <span class="health-header__meta">{{ device_name | default: "iPhone" }}</span>
          <span class="health-header__meta">updated {{ captured_time | default: "" }}</span>
        </div>
      </div>

      <div class="health-shell">
        <div class="health-card health-hero">
          <div class="health-rings">
            <svg viewBox="0 0 240 240" role="img" aria-label="Apple Health activity rings">
              <circle class="ring-separator" cx="120" cy="120" r="74" stroke-width="24"></circle>
              <circle class="ring-separator" cx="120" cy="120" r="52" stroke-width="24"></circle>
              <circle class="ring-separator" cx="120" cy="120" r="30" stroke-width="22"></circle>

              <circle class="ring-track" cx="120" cy="120" r="74" stroke-width="18"></circle>
              <circle class="ring-track" cx="120" cy="120" r="52" stroke-width="18"></circle>
              <circle class="ring-track" cx="120" cy="120" r="30" stroke-width="16"></circle>

              <circle class="ring-progress ring-progress--move" cx="120" cy="120" r="74" stroke-width="18" stroke-dasharray="465" stroke-dashoffset="{{ move_offset }}"></circle>
              <circle class="ring-progress ring-progress--exercise" cx="120" cy="120" r="52" stroke-width="18" stroke-dasharray="327" stroke-dashoffset="{{ exercise_offset }}"></circle>
              <circle class="ring-progress ring-progress--stand" cx="120" cy="120" r="30" stroke-width="16" stroke-dasharray="188" stroke-dashoffset="{{ stand_offset }}"></circle>

              <text class="ring-center" x="120" y="122">Today</text>
            </svg>
          </div>

          <div class="health-stats">
            <div class="health-stat">
              <div>
                <span class="health-stat__label">Move</span>
                <span class="health-stat__value">{{ rings.move | default: 0 | round }} CAL</span>
                <span class="health-stat__goal">goal {{ rings.move_goal | default: 0 | round }} CAL</span>
              </div>
              <span class="health-stat__badge">{{ rings.move_percent | default: 0 | round }}%</span>
            </div>

            <div class="health-stat">
              <div>
                <span class="health-stat__label">Exercise</span>
                <span class="health-stat__value">{{ rings.exercise | default: 0 | round }} MIN</span>
                <span class="health-stat__goal">goal {{ rings.exercise_goal | default: 0 | round }} MIN</span>
              </div>
              <span class="health-stat__badge">{{ rings.exercise_percent | default: 0 | round }}%</span>
            </div>

            <div class="health-stat">
              <div>
                <span class="health-stat__label">Stand</span>
                <span class="health-stat__value">{{ rings.stand | default: 0 | round }} HRS</span>
                <span class="health-stat__goal">goal {{ rings.stand_goal | default: 0 | round }} HRS</span>
              </div>
              <span class="health-stat__badge">{{ rings.stand_percent | default: 0 | round }}%</span>
            </div>
          </div>
        </div>

        <div class="health-grid">
          <div class="health-card health-metric">
            <span class="health-metric__label">Step Count</span>
            <span class="health-metric__value">{{ activity.steps | default: 0 }}</span>
            <span class="health-metric__detail">today</span>
          </div>

          <div class="health-card health-metric">
            <span class="health-metric__label">Distance</span>
            <span class="health-metric__value">{{ activity.distance_mi | default: 0 | round: 2 }} MI</span>
            <span class="health-metric__detail">{{ activity.distance_km | default: 0 | round: 2 }} km</span>
          </div>

          <div class="health-card health-metric">
            <span class="health-metric__label">Flights</span>
            <span class="health-metric__value">{{ activity.flights_climbed | default: 0 }}</span>
            <span class="health-metric__detail">floors climbed</span>
          </div>
        </div>
      </div>

      <div class="health-footer">
        <span>{{ profile_name | default: "Apple Health" }}</span>
        <span>{{ device_name | default: "iPhone" }}</span>
      </div>
    </div>
  </div>
</div>
